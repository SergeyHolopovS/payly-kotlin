# Список поддерживаемых валют (ISO 4217), через запятую, без пробелов
PAYMENT_SUPPORTED_CURRENCIES=RUB,USD,EUR

# Границы случайной задержки асинхронной обработки платежа планировщиком, сек
PAYMENT_PROCESSING_MIN_DELAY_SECONDS=1
PAYMENT_PROCESSING_MAX_DELAY_SECONDS=5
# Размер пачки платежей, забираемой планировщиком обработки за один проход
PAYMENT_PROCESSING_BATCH_SIZE=100
# Интервал опроса планировщика обработки платежей, мс
PAYMENT_PROCESSING_POLL_INTERVAL_MS=1000

# Kafka-топик для публикации outbox-событий
OUTBOX_PUBLISHER_TOPIC=payment.events
# Размер пачки outbox-событий, публикуемой за один проход
OUTBOX_PUBLISHER_BATCH_SIZE=100
# Интервал опроса outbox_events publisher'ом, мс
OUTBOX_PUBLISHER_POLL_INTERVAL_MS=5000

# Порт Actuator (health, info, prometheus). Должен отличаться от порта API:
# на общем порту prometheus/metrics закрываются (см. SecurityConfig)
MANAGEMENT_SERVER_PORT=8081

# Учётная запись администратора Grafana (http://localhost:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
