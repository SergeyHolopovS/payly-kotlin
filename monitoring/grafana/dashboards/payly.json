{
  "uid": "payly-overview",
  "title": "Payly — обзор",
  "description": "Бизнес-метрики платежей, гейтвей, outbox, вебхуки, HTTP и JVM",
  "tags": [
    "payly"
  ],
  "timezone": "browser",
